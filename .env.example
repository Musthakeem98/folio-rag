# ---- API ----
FOLIO_API_HOST=0.0.0.0
FOLIO_API_PORT=8000
FOLIO_LOG_LEVEL=INFO

# ---- Data paths (host-side, mounted into containers) ----
FOLIO_DATA_DIR=./data
FOLIO_MODELS_DIR=./models

# ---- Vector store ----
FOLIO_STORE_BACKEND=lancedb
FOLIO_LANCEDB_PATH=/data/lancedb

# ---- Embeddings ----
FOLIO_EMBED_MODEL=BAAI/bge-m3
FOLIO_EMBED_DEVICE=cpu

# ---- Reranker ----
FOLIO_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
FOLIO_RERANKER_TOP_K=5

# ---- LLM (Ollama) ----
FOLIO_LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
FOLIO_LLM_MODEL=qwen2.5:7b-instruct

# ---- Docling (document parsing service) ----
FOLIO_DOCLING_HOST=http://docling:5001

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
