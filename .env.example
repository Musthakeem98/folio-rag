# ---- API ----
LUMEN_API_HOST=0.0.0.0
LUMEN_API_PORT=8000
LUMEN_LOG_LEVEL=INFO

# ---- Data paths (host-side, mounted into containers) ----
LUMEN_DATA_DIR=./data
LUMEN_MODELS_DIR=./models

# ---- Vector store ----
LUMEN_STORE_BACKEND=lancedb
LUMEN_LANCEDB_PATH=/data/lancedb

# ---- Embeddings ----
LUMEN_EMBED_MODEL=BAAI/bge-m3
LUMEN_EMBED_DEVICE=cpu

# ---- Reranker ----
LUMEN_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
LUMEN_RERANKER_TOP_K=5

# ---- LLM (Ollama) ----
LUMEN_LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
LUMEN_LLM_MODEL=qwen2.5:7b-instruct

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
